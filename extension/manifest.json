{
  "manifest_version": 3,
  "name": "Hide AI Replies",
  "version": "1.0.1",
  "description": "Hides posts, replies, reposts and likes from AI reply bots on X, using the public blockedforaireply.levels.io list.",
  "homepage_url": "https://hideaireplies.borodutch.com",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://blockedforaireply.levels.io/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hideaireplies@borodutch.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
